<UserControl x:Class="NamePlateApp.Controls.FormattedTextEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel>
        <WrapPanel Margin="0,0,0,2">
            <ComboBox x:Name="RunFont" Width="170" Margin="0,2" ToolTip="Font of the selected characters" IsEditable="True" IsReadOnly="True"
                      ItemsSource="{Binding FontNames, ElementName=Root}" SelectionChanged="RunFont_SelectionChanged"
                      DropDownClosed="RunFont_DropDownClosed" PreviewKeyDown="RunFont_PreviewKeyDown">
                <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="RunSize" Width="46" Margin="6,2,0,2" Padding="3,2" ToolTip="Size (mm) of the selected characters - Enter applies"
                     TextChanged="RunSize_TextChanged" LostFocus="RunSize_LostFocus" KeyDown="RunSize_KeyDown"/>
            <TextBlock Text=" mm " VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ToggleButton x:Name="RunBold" Width="28" Margin="0,2,4,2" Content="B" FontWeight="Bold" ToolTip="Bold (Ctrl+B)" Click="RunBold_Click"/>
            <ToggleButton x:Name="RunItalic" Width="28" Margin="0,2,4,2" Content="I" FontStyle="Italic" ToolTip="Italic (Ctrl+I)" Click="RunItalic_Click"/>
            <Button Content="Clear" Margin="0,2" Padding="6,2" ToolTip="Return the selected characters to the default font" Click="Clear_Click"/>
        </WrapPanel>
        <RichTextBox x:Name="Editor" MinHeight="64" MaxHeight="160" VerticalScrollBarVisibility="Auto" AcceptsTab="False"
                     TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
            </RichTextBox.Resources>
        </RichTextBox>
    </StackPanel>
</UserControl>
