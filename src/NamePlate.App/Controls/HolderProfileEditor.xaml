<UserControl x:Class="NamePlateApp.Controls.HolderProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="http://helix-toolkit.org/wpf">
    <Grid>
        <helix:HelixViewport3D x:Name="View" Background="White" ClipToBounds="True"
                               IsRotationEnabled="False" ShowViewCube="False" ShowCoordinateSystem="False"
                               IsHeadLightEnabled="False" ZoomExtentsWhenLoaded="False" PanGesture="RightClick"
                               PreviewMouseLeftButtonDown="View_PreviewMouseLeftButtonDown"
                               PreviewMouseLeftButtonUp="View_PreviewMouseLeftButtonUp">
            <helix:HelixViewport3D.Camera>
                <OrthographicCamera Position="0,0,500" LookDirection="0,0,-1" UpDirection="0,1,0" Width="80"
                                    NearPlaneDistance="0.1" FarPlaneDistance="2000"/>
            </helix:HelixViewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content><AmbientLight Color="White"/></ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D x:Name="Fill"/>
            <helix:LinesVisual3D x:Name="Outline" Color="#FF1F2937" Thickness="2"/>
        </helix:HelixViewport3D>
        <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,4" Foreground="Gray" FontSize="11" IsHitTestVisible="False"
                   Text="front ← plate → back"/>
        <Button Content="Fit" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4" Padding="8,1" Click="Fit_Click"/>
    </Grid>
</UserControl>
